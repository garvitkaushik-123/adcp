+def test_generated_poc_collision_symbol_map_covers_publicly_exported_names() -> None:
+    import importlib
+    types_module = importlib.import_module("adcp.types")
+    for (module_suffix, symbol), replacement in v3_to_v4.GENERATED_POC_COLLISION_SYMBOL_MAP.items():
+        qualified_alias = replacement.rsplit(".", 1)[-1]
+        assert hasattr(types_module, qualified_alias)
+
+def test_flags_collision_alias_with_precise_hint(tmp_path: Path) -> None:
+    _write(tmp_path, "code.py", "from adcp.types.generated_poc.core.account import Account\n")
+    report = v3_to_v4.run(tmp_path, apply_changes=False)
+    private = [f for f in report.flagged if f.kind == "flag_private"]
+    by_symbol = {f.before: f for f in private}
+    assert "Account" in by_symbol
+    finding = by_symbol["Account"]
+    assert finding.after == "adcp.types.CoreAccount"
+    assert finding.hint is not None and "CoreAccount" in finding.hint
+
+def test_flags_collision_alias_multiple_modules_different_hints(tmp_path: Path) -> None:
+    _write(tmp_path, "code.py",
+        "from adcp.types.generated_poc.account.sync_accounts_response import Account\n"
+        "from adcp.types.generated_poc.creative.list_creatives_response import Creative\n")
+    report = v3_to_v4.run(tmp_path, apply_changes=False)
+    private = [f for f in report.flagged if f.kind == "flag_private"]
+    by_symbol = {f.before: f for f in private}
+    assert by_symbol["Account"].after == "adcp.types.SyncAccountsAccount"
+    assert by_symbol["Creative"].after == "adcp.types.ListCreativesCreative"
+
+def test_collision_alias_not_auto_applied(tmp_path: Path) -> None:
+    path = _write(tmp_path, "code.py",
+        "from adcp.types.generated_poc.core.account import Account\n"
+        "acc: Account = Account(id='x')\n")
+    original = path.read_text()
+    report = v3_to_v4.run(tmp_path, apply_changes=True, auto_apply=True)
+    assert path.read_text() == original
+    flagged_symbols = {f.before for f in report.flagged if f.kind == "flag_private"}
+    assert "Account" in flagged_symbols
+    assert report.auto_applied == []
